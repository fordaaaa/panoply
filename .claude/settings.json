{
  "$comment": "Hand-maintained, not generated by build.mjs. Registers the caveman-compression nudge (see .claude/hooks/caveman-nudge.mjs, skills/caveman/SKILL.md).",
  "caveman": {
    "scope": "everywhere"
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "command", "command": "node .claude/hooks/caveman-nudge.mjs" }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Task",
        "hooks": [
          { "type": "command", "command": "node .claude/hooks/caveman-nudge.mjs" }
        ]
      }
    ]
  }
}
