# Private, local-only knowledge — never published.
# Point Obsidian at this folder if you want a vault; it stays out of git.
# Exception: index.md is a committed template documenting the convention;
# every other file here stays private.
.notes/
!.notes/index.md

# Local Claude Code state / scratch generated by running the cr-* commands
# against THIS repo (maps, learned notes, toggles). Consumers of the commands
# commit their own .claude/cr/ — but we don't publish ours.
.claude/cr/
.claude/settings.local.json
